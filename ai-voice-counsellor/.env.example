# ===== Backend environment variables =====
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# On Render, add these in the dashboard under "Environment" instead.

# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ---- Bhashini (Gujarati speech) ----
BHASHINI_UDYAT_KEY=your_ulca_key
BHASHINI_INFERENCE_KEY=your_inference_key

# ---- App ----
DEFAULT_COUNTRY_CODE=+91
# Public URL Twilio uses to reach this server.
# Local: your ngrok URL.  On Render: https://<your-app>.onrender.com
PUBLIC_BASE_URL=https://your-app.onrender.com
PORT=5000

# ---- Voice (optional; these are the current defaults) ----
BHASHINI_TTS_GENDER=male
BHASHINI_TTS_SAMPLING_RATE=22050
BHASHINI_TTS_VOLUME=1.0
BHASHINI_TTS_SOFTNESS=1.0
