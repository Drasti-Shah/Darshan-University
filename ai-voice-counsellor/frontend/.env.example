# ===== Frontend environment variables =====
# Copy to ".env.local" for local dev. On Vercel, set these in the dashboard.

# URL of the Flask backend API.
# Local: http://127.0.0.1:5000   (use 127.0.0.1, not localhost, on Windows)
# Deployed: https://<your-app>.onrender.com
NEXT_PUBLIC_API_BASE=http://127.0.0.1:5000

# Demo login (frontend-only mock auth)
NEXT_PUBLIC_DEMO_USER=admin
NEXT_PUBLIC_DEMO_PASS=darshan123
